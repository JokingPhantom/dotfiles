# Shared git settings. ~/.gitconfig includes this file first, so anything set
# there (identity, credentials, `git config --global` writes) wins.
# Needs git 2.38+ (zdiff3, rebase.updateRefs).

[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	ff = only               # never create a surprise merge commit; rebase or merge explicitly
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true          # replay conflict resolutions you've made before
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[commit]
	verbose = true          # show the diff while writing the message
[help]
	autocorrect = prompt
[delta]                 # used only when delta is installed (see bash/tools.bash)
	navigate = true
	line-numbers = true

# No aliases here: custom commands are kb-git-* scripts in bin/ (run kb-help).
