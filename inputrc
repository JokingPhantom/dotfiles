# Readline settings for bash and other readline programs (mysql, irb, psql).
$include /etc/inputrc

# Completion
set completion-ignore-case on
set completion-map-case on          # - and _ are interchangeable
set show-all-if-ambiguous on        # list matches on the first Tab
set colored-stats on                # color completions by file type
set colored-completion-prefix on
set mark-symlinked-directories on
set visible-stats on

# Up/Down search history for lines starting with what's typed so far.
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Don't ring the bell; don't echo ^C.
set bell-style none
set echo-control-characters off
