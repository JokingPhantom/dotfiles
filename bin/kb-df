#!/usr/bin/env bash
# kb-df: disk usage of real filesystems, human sizes, without tmpfs/snap/overlay noise
#
# Usage: kb-df [PATH...]
# shellcheck source=lib/kb.sh
. "${BASH_SOURCE[0]%/*}/../lib/kb.sh"

if df -hT -x tmpfs / >/dev/null 2>&1; then # GNU-style df
  exec df -hT -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x rootfs "$@"
fi
exec df -hl "$@"
