#!/usr/bin/env bash
# kb-jest: run the Jest tests related to what this branch changed
#
# Usage: kb-jest [BASE]      BASE defaults to origin's default branch
# Jest's --findRelatedTests finds every test that imports a changed file.
# shellcheck source=lib/kb.sh
. "${BASH_SOURCE[0]%/*}/../lib/kb.sh"

cd "$(git rev-parse --show-toplevel)" || exit
files=()
while IFS= read -r f; do
  case $f in node_modules/* | */node_modules/*) ;; *) files+=("$f") ;; esac
done < <(kb-git-changed ${1:+"$1"} -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')

[ ${#files[@]} -gt 0 ] || { echo "No changed JS/TS files."; exit 0; }
printf 'Jest, tests related to:\n'; printf '  %s\n' "${files[@]}"
# shellcheck disable=SC2046
exec $(kb_package_runner) jest --passWithNoTests --findRelatedTests "${files[@]}"
