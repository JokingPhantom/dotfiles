#!/usr/bin/env bash
# kb-git-changed: files this branch touches (committed since it forked, uncommitted, untracked)
#
# Usage: kb-git-changed [BASE] [-- PATHSPEC...]      e.g.  kb-git-changed -- '*.rb'
# BASE defaults to origin's default branch. Deleted files are left out. Paths
# are relative to the repository root.
base=
if [ $# -gt 0 ] && [ "$1" != -- ]; then base=$1; shift; fi
if [ "${1:-}" = -- ]; then shift; fi

cd "$(git rev-parse --show-toplevel)" || exit
[ -n "$base" ] || base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo main)
fork=$(git merge-base HEAD "$base") || exit
{
  git diff --name-only --diff-filter=d "$fork" -- "$@"
  git ls-files --others --exclude-standard -- "$@"
} | sort -u
